# Local development of the console API. Copy to .env; never commit the copy.
# On Railway every value below comes from .railway/railway.ts and scripts/setup.mjs.

NODE_ENV=development
LOG_LEVEL=debug
HOST=127.0.0.1
PORT=8787

# Where the browser reaches the console; the Vite dev server proxies /admin/api
# here. Its hostname is also the community the console manages, so community
# pages stay empty unless the relay database has a community under this host.
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Sign-in. The hash is scrypt, in the form scripts/setup.mjs writes. To make one:
#   node -e "import('./scripts/lib/keys.mjs').then(async (k) => console.log(await k.hashPassword(process.argv[1])))" '<password>'
# (run from the repository root)
ADMIN_USERNAME=dev
ADMIN_PASSWORD_HASH=
# At least 32 bytes:  openssl rand -base64 48
SESSION_SECRET=

# Everything below is optional. The console starts without it and each page
# that needs a missing piece says so.

# The relay's Postgres. Community pages (members, channels, counts) read it.
DATABASE_URL=
# The relay itself, and the hostname it serves the community under.
RELAY_URL=
RELAY_HEALTH_URL=
RELAY_METRICS_URL=

# Owner key of the community (hex or nsec): signs member, invite and ban changes.
CONSOLE_SECRET_KEY=
# 32 random bytes, base64:  openssl rand -base64 32
CONSOLE_ENCRYPTION_KEY=

# Shared with the agent host.
HIVE_TOKEN=

# Railway API access for the Services, Logs, Metrics and Deployments pages.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Secret path segment of the webhook Railway posts alerts to.
WEBHOOK_TOKEN=
# Slack, Discord or Feishu incoming webhook that also receives alerts.
ALERT_FORWARD_URL=
